{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/blog/:path+", "destination": "/blog" },
    { "source": "/admin/:path+", "destination": "/admin" }
  ]
}
